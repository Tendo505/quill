// Classic recursive quicksort using list concatenation.
fn quicksort(xs) {
  if (len(xs) <= 1) { return xs; }
  let pivot = xs[0];
  let rest = slice(xs, 1);
  let smaller = filter(rest, fn(x) => x < pivot);
  let larger = filter(rest, fn(x) => x >= pivot);
  return quicksort(smaller) + [pivot] + quicksort(larger);
}

let data = [38, 27, 43, 3, 9, 82, 10, 3];
print("input: ", data);
print("sorted:", quicksort(data));

// Binary search on the sorted result
fn search(xs, target) {
  let lo = 0;
  let hi = len(xs) - 1;
  while (lo <= hi) {
    let mid = floor((lo + hi) / 2);
    if (xs[mid] == target) { return mid; }
    if (xs[mid] < target) { lo = mid + 1; } else { hi = mid - 1; }
  }
  return -1;
}
print("index of 43:", search(quicksort(data), 43));
